# OpenAI API Key (Required for live AI generation. If omitted, built-in smart template fallback is used)
OPENAI_API_KEY=

# Default Model (e.g. gpt-4o, gpt-4o-mini, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# MongoDB Connection String (Optional. If omitted or offline, the app persists to local JSON database in .data/)
MONGODB_URI=

# Application Secret
AUTH_SECRET=fiverr-ai-assistant-secret-32-chars-long
